install-go() {
    set -e

    case "$(uname)" in
        Linux) local os='linux' ;;
        Darwin) local os='darwin' ;;
    esac
    case "$(arch)" in
        x86_64) local arch='amd64' ;;
        arm64) local arch='arm64' ;;
    esac

    case "$os-$arch" in
        linux-amd64) ;;
        darwin-arm64) ;;
        *) echo "[install-go] unsupported platform: $os-$arch"; return ;;
    esac

    echo -n '[install-go] fetching versions... '
    local versions=$(curl -sL 'https://golang.org/dl/?mode=json')
    echo '✓'

    local remote_version=$(echo "$versions" | jq -r '.[0].version')
    local local_version=$(go version | awk '{print $3}')
    echo "[install-go] remote: $remote_version, local: $local_version"

    __read_prompt '[install-go] continue? [y/N]: '
    if [ "$REPLY" != 'y' ]; then
        echo '[install-go] abort'
        return
    fi

    echo -n  '[install-go] downloading... '

    local tarball="/tmp/$remote_version.$os-$arch.tar.gz"
    curl -sL https://go.dev/dl/$remote_version.$os-$arch.tar.gz -o $tarball

    if [ "$os" = 'darwin' ]; then
        local tarball_size=$(stat -f %z $tarball)
    else
        local tarball_size=$(stat -c %s $tarball)
    fi
    if [ $tarball_size -lt 10000000 ]; then
        # 10MB未満ならダウンロード失敗とみなす
        echo ''
        echo '[install-go] download failed'
        return
    fi
    echo '✓'

    echo '[install-go] install...'
    rm -rf ~/.local/go && tar -C ~/.local -xzf "/tmp/$remote_version.$os-$arch.tar.gz"
    echo '[install-go] done'
    set +e
}

export PATH=$PATH:$HOME/.local/go/bin
export PATH=$PATH:$HOME/go/bin
